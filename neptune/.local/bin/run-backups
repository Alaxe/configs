#!/bin/bash
FLAGS="--transfers 32 --progress --fast-list -l"
/usr/bin/rclone sync google-drive: /home/alex/.google-drive $FLAGS

for link in /home/alex/.backup/*; do
    dir_name=$(basename $link)
    dir_path=$(readlink -f $link)
    /usr/bin/rclone sync ${dir_path} b2-neptune:${dir_name} $FLAGS
done
